APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=acik_lise
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Sınav / Soru Üretimi -------------------------------------------------
# Ders başına üretilecek soru bankası büyüklüğü
EXAM_QUESTIONS_PER_COURSE=40
# Bir sınavda bankadan rastgele seçilecek soru sayısı
EXAM_QUESTIONS_PER_EXAM=20
# PDF işlenirken maksimum sayfa (boş = tümü)
# EXAM_PDF_MAX_PAGES=

# Soru üretim sürücüsü: local | openrouter
EXAM_GENERATOR=local

# OpenRouter (yapay zekâ ile soru üretimi). Kullanmak için EXAM_GENERATOR=openrouter yapın.
# Ücretsiz kullanım: https://openrouter.ai/models?q=free  (20 istek/dk, 50 istek/gün)
OPENROUTER_API_KEY=
# Ücretsiz yönlendirici (mevcut ücretsiz modeller arasından seçer):
OPENROUTER_MODEL=openrouter/free
# İsterseniz sabit bir yedek zinciri verin (doluysa OPENROUTER_MODEL yok sayılır).
# JSON üretimine uygun (reasoning'siz / yapılandırılmış çıktı destekli) ücretsiz modeller:
OPENROUTER_MODELS=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-super-120b-a12b:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_TIMEOUT=90
# OPENROUTER_MAX_INPUT_CHARS=12000
# OPENROUTER_QUESTIONS_PER_REQUEST=10
# OPENROUTER_MAX_TOKENS=4096
# Muhakemeli (reasoning) modellerin JSON yerine "düşünme" üretmesini engellemek için kapalı tutun:
# OPENROUTER_ALLOW_REASONING=false
# Yapılandırılmış JSON modu (destekleyen modellerde JSON uyumunu artırır):
# OPENROUTER_JSON_MODE=true
